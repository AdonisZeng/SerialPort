<Window x:Class="SerialPort.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SerialPort  串口调试工具"
        Width="1080" Height="720"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12"
        Background="{DynamicResource PanelBackBrush}">
    <Window.Resources>
        <!-- 下拉框共用模板：选中项文本过长时以省略号截断（保留下拉箭头），下拉选项仍完整显示。
             文本列与箭头列分离，默认模板中选中项文字会覆盖箭头，导致长描述时箭头不可见。 -->
        <ControlTemplate x:Key="ComboBoxTemplate" TargetType="{x:Type ComboBox}">
            <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                <!-- 箭头列固定 18px（与按钮模板内箭头区宽度一致）；若不固定列宽，文本列会
                     延伸到箭头下方，导致文字与三角形重叠 -->
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                </Grid.ColumnDefinitions>
                <ToggleButton x:Name="ToggleButton" Grid.ColumnSpan="2" Focusable="False"
                              IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                    <ToggleButton.Template>
                        <ControlTemplate TargetType="{x:Type ToggleButton}">
                            <Border x:Name="toggleRoot"
                                    Background="{DynamicResource InputBackBrush}"
                                    BorderBrush="{DynamicResource SecondaryBtnBorderBrush}"
                                    BorderThickness="1" SnapsToDevicePixels="True">
                                <Border x:Name="splitBorder" Width="18" HorizontalAlignment="Right"
                                        BorderBrush="{DynamicResource SecondaryBtnBorderBrush}"
                                        BorderThickness="1,0,0,0">
                                    <Path x:Name="arrow" Data="M 0 0 L 4 4 L 8 0 Z"
                                          Fill="{DynamicResource InputForeBrush}"
                                          HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" />
                                </Border>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="toggleRoot" Property="Background"
                                            Value="{DynamicResource ComboHoverBackBrush}" />
                                    <Setter TargetName="toggleRoot" Property="BorderBrush"
                                            Value="{DynamicResource ComboHoverBackBrush}" />
                                    <Setter TargetName="arrow" Property="Fill"
                                            Value="{DynamicResource InputForeBrush}" />
                                </Trigger>
                                <Trigger Property="IsChecked" Value="True">
                                    <Setter TargetName="toggleRoot" Property="Background"
                                            Value="{DynamicResource ComboHoverBackBrush}" />
                                    <Setter TargetName="toggleRoot" Property="BorderBrush"
                                            Value="{DynamicResource ComboHoverBackBrush}" />
                                    <Setter TargetName="arrow" Property="Fill"
                                            Value="{DynamicResource InputForeBrush}" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter TargetName="toggleRoot" Property="Background"
                                            Value="{DynamicResource InputBackBrush}" />
                                    <Setter TargetName="toggleRoot" Property="BorderBrush"
                                            Value="{DynamicResource SeparatorBrush}" />
                                    <Setter TargetName="arrow" Property="Fill"
                                            Value="{DynamicResource SeparatorBrush}" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </ToggleButton.Template>
                </ToggleButton>
                <!-- 选中项文本：限定在文本列内，超出部分以省略号截断。
                     用普通 Binding（而非 TemplateBinding）绑定 SelectionBoxItem，
                     TemplateBinding 不做对象→字符串转换，会导致选中项不显示。 -->
                <TextBlock x:Name="SelectionTextBlock" Grid.Column="0" IsHitTestVisible="False"
                           Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                           HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                           Margin="5,0,0,0"
                           Foreground="{TemplateBinding Foreground}" />
                <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                         Visibility="Collapsed"
                         Text="{TemplateBinding Text}"
                         VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                         HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                         Margin="4,0,2,0"
                         Background="Transparent"
                         BorderThickness="0"
                         CaretBrush="{TemplateBinding Foreground}"
                         Foreground="{TemplateBinding Foreground}" />
                <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" AllowsTransparency="True" Margin="1"
                       IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                       PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}"
                       Placement="Bottom">
                    <!-- 下拉面板：MinWidth 与下拉框同宽，内容更宽时可扩展（完整显示端口描述） -->
                    <Border x:Name="DropDownBorder"
                            MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                            MaxHeight="{TemplateBinding MaxDropDownHeight}"
                            Background="{DynamicResource InputBackBrush}"
                            BorderBrush="{DynamicResource SecondaryBtnBorderBrush}"
                            BorderThickness="1">
                        <ScrollViewer x:Name="DropDownScrollViewer">
                            <Grid RenderOptions.ClearTypeHint="Enabled">
                                <ItemsPresenter x:Name="ItemsPresenter"
                                                KeyboardNavigation.DirectionalNavigation="Contained" />
                            </Grid>
                        </ScrollViewer>
                    </Border>
                </Popup>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsEditable" Value="True">
                    <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                    <Setter TargetName="SelectionTextBlock" Property="Visibility" Value="Collapsed" />
                </Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 行0 顶栏 -->
            <RowDefinition Height="*" />
            <!-- 行1 接收区 -->
            <RowDefinition Height="Auto" />
            <!-- 行2 分隔条 -->
            <RowDefinition Height="Auto" />
            <!-- 行3 配置 + 发送区 -->
            <RowDefinition Height="Auto" />
            <!-- 行4 状态栏 -->
        </Grid.RowDefinitions>

        <!-- 顶栏：主题切换按钮 -->

        <!-- 接收区：只读文本 + 悬浮清空按钮 -->
        <Grid Grid.Row="1" Background="{DynamicResource PanelBackBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="103*"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="txtReceive" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="10pt"
                     Padding="6,6,78,6"
                     SelectionBrush="#80466EC8" Margin="80,8,10,10" Grid.RowSpan="2" />
            <!-- 左下角悬浮按钮组：筛选 / 搜索 / 清空（居中于界面左边界与接收区左边界之间，锚定左下角随窗口缩放） -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5,0,0,10">
                <Button x:Name="btnFilterReceive" Content="筛选" Click="BtnFilterReceive_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="70" Height="26" Margin="0,0,0,6" ToolTip="按行筛选接收区显示内容" />
                <Button x:Name="btnSearchReceive" Content="搜索" Click="BtnSearchReceive_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="70" Height="26" Margin="0,0,0,6" ToolTip="在接收区中查找内容" />
                <Button x:Name="btnFrameParser" Content="帧解析" Click="BtnFrameParser_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="70" Height="26" Margin="0,0,0,6" ToolTip="按帧头/帧尾提取完整帧并校验" />
                <Button x:Name="btnClearReceive" Content="清空" Click="BtnClearReceive_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="70" Height="26" />
            </StackPanel>
        </Grid>

        <!-- 分隔条：可拖动调整接收区与配置区高度 -->
        <GridSplitter Grid.Row="2" Height="2" HorizontalAlignment="Stretch"
                      Background="{DynamicResource SeparatorBrush}"
                      ResizeBehavior="PreviousAndNext" />

        <!-- 配置 + 发送区 -->
        <Grid Grid.Row="3" Background="{DynamicResource HeaderBackBrush}" MinHeight="228">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- 配置区 -->
                <RowDefinition Height="Auto" />
                <!-- 发送框 -->
                <RowDefinition Height="Auto" />
                <!-- 按钮栏 -->
            </Grid.RowDefinitions>

            <!-- 配置区：两行三列下拉 + 复选行 -->
            <Grid Grid.Row="0" Margin="12,8,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 行0：端口号 / 波特率 / 数据位 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="端口号" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="cboPortName" Width="102" Height="26" IsEditable="False"
                              VerticalContentAlignment="Center"
                              Template="{StaticResource ComboBoxTemplate}"
                              DropDownOpened="cboPortName_DropDown" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="波特率" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="cboBaudRate" Width="102" Height="26" IsEditable="True"
                              VerticalContentAlignment="Center"
                              Template="{StaticResource ComboBoxTemplate}" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="数据位" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="cboDataBits" Width="102" Height="26" IsEditable="False"
                              VerticalContentAlignment="Center"
                              Template="{StaticResource ComboBoxTemplate}" />
                </StackPanel>

                <!-- 行1：停止位 / 校验位 / 流控 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="停止位" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="cboStopBits" Width="102" Height="26" IsEditable="False"
                              VerticalContentAlignment="Center"
                              Template="{StaticResource ComboBoxTemplate}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="校验位" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="cboParity" Width="102" Height="26" IsEditable="False"
                              VerticalContentAlignment="Center"
                              Template="{StaticResource ComboBoxTemplate}" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="流　控" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="cboHandshake" Width="102" Height="26" IsEditable="False"
                              VerticalContentAlignment="Center"
                              Template="{StaticResource ComboBoxTemplate}" />
                </StackPanel>

                <!-- 行2：打开串口按钮 + 复选项 -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
                    <Button x:Name="btnToggleConnect" Content="打开串口" Click="BtnToggleConnect_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            Background="{StaticResource PortOpenBrush}"
                            Width="88" Height="36" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <Label Content="编码" Padding="0" VerticalAlignment="Center" Margin="0,0,4,0" />
                    <ComboBox x:Name="cboEncoding" Width="76" Height="26" IsEditable="False"
                              Margin="0,0,12,0" VerticalContentAlignment="Center"
                              Template="{StaticResource ComboBoxTemplate}"
                              SelectionChanged="CboEncoding_SelectionChanged"
                              ToolTip="接收/发送文本编码（GBK 兼容 GB2312）" />
                    <CheckBox x:Name="chkTimestamp" Content="时间戳显示" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="chkSendHex" Content="16进制发送" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="chkReceiveHex" Content="16进制显示" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="chkSendNewLine" Content="追加换行符" IsChecked="True"
                              Margin="0,0,12,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="chkAutoScroll" Content="自动滚动" IsChecked="True" Margin="0,0,12,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="chkPauseReceive" Content="暂停显示" VerticalAlignment="Center"
                              Checked="ChkPauseReceive_Changed" Unchecked="ChkPauseReceive_Changed"
                              ToolTip="暂停接收区刷新，恢复后补齐显示（数据不丢失）" Margin="0,0,12,0" />
                    <CheckBox x:Name="chkLocalEcho" Content="本地回显" VerticalAlignment="Center"
                              ToolTip="发送的内容以 [TX] 前缀回显到接收区" Margin="0,0,12,0" />
                    <CheckBox x:Name="chkSaveFile" Content="文件保存" VerticalAlignment="Center"
                              Checked="ChkSaveFile_Changed" Unchecked="ChkSaveFile_Changed" />
                </StackPanel>

                <!-- 列3：文件保存区（路径选择 + 文件名修改） -->
                <Grid Grid.Row="0" Grid.Column="3" Grid.RowSpan="2"
                      Margin="18,0,0,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <!-- 标签列（两行标签共用，天然左对齐） -->
                        <ColumnDefinition Width="*" />
                        <!-- 输入框列 -->
                        <ColumnDefinition Width="Auto" />
                        <!-- 按钮列 -->
                    </Grid.ColumnDefinitions>
                    <!-- 行0：保存路径 + 浏览按钮 -->
                    <Label Grid.Row="0" Content="文件保存路径" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="txtSavePath" Grid.Row="0" Grid.Column="1" Height="26" IsReadOnly="True"
                             VerticalContentAlignment="Center" />
                    <Button x:Name="btnBrowsePath" Grid.Row="0" Grid.Column="2" Content="…" Width="34" Height="26"
                            Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnBrowsePath_Click" />
                    <!-- 行1：文件名 + 修改按钮（串口打开时禁止修改） -->
                    <Label Grid.Row="1" Content="        文 件 名" Padding="0" VerticalAlignment="Center" Margin="0,8,6,0" />
                    <TextBox x:Name="txtSaveFileName" Grid.Row="1" Grid.Column="1" Height="26" IsReadOnly="True"
                             VerticalContentAlignment="Center" Margin="0,8,0,0" />
                    <Button x:Name="btnModifyFileName" Grid.Row="1" Grid.Column="2" Content="修改" Width="40" Height="26"
                            Margin="6,8,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnModifyFileName_Click" />
                </Grid>

            </Grid>

            <!-- 发送框 -->
            <TextBox x:Name="txtSend" Grid.Row="1" Height="84" Margin="12,0,12,8"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="10pt" />

            <!-- 按钮栏 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Height="32"
                        HorizontalAlignment="Left" Margin="12,0,0,8">
                <Button x:Name="btnSend" Content="发送" Click="BtnSend_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Background="{StaticResource SendBtnBrush}"
                        Width="90" Height="28" Margin="0,0,8,0" />
                <Button x:Name="btnClearSend" Content="清空" Click="BtnClearSend_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="70" Height="26" />
                <TextBox x:Name="txtTimerInterval" Width="56" Height="26" Text="1000"
                         VerticalContentAlignment="Center" Margin="10,0,4,0"
                         ToolTip="定时发送间隔（毫秒），正整数" />
                <Label Content="ms" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
                <Button x:Name="btnTimerSend" Content="定时发送" Click="BtnTimerSend_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="80" Height="26" ToolTip="按设定间隔循环发送发送框内容，再次点击停止" />
                <Button x:Name="btnQuickCommands" Content="快捷指令" Click="BtnQuickCommands_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="80" Height="26" Margin="8,0,0,0" ToolTip="管理并发送预设快捷指令" />
                <CheckBox x:Name="chkDtr" Content="DTR" IsChecked="True" IsEnabled="False"
                          Margin="18,0,2,0" VerticalAlignment="Center" Click="ChkPin_Changed"
                          ToolTip="DTR 引脚电平（连接后可切换）" />
                <CheckBox x:Name="chkRts" Content="RTS" IsEnabled="False"
                          Margin="12,0,0,0" VerticalAlignment="Center" Click="ChkPin_Changed"
                          ToolTip="RTS 引脚电平（连接后可切换）" />
            </StackPanel>
            <Button x:Name="btnThemeToggle" Content="深色模式" Click="BtnThemeToggle_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="100" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,12,0" Grid.Row="2" />
        </Grid>

        <!-- 状态栏：左侧动态状态信息，右侧统计区与检查更新入口 -->
        <Border Grid.Row="4" Height="22" Background="{DynamicResource TopBarBackBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtStatus" Text="  就绪" Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource StatusTextBrush}" />
                <TextBlock x:Name="txtStats" Grid.Column="1" VerticalAlignment="Center" Margin="0,0,12,0"
                           Foreground="{DynamicResource StatusTextBrush}" />
                <Button x:Name="btnCheckUpdate" Grid.Column="2" Content="检查更新" Click="BtnCheckUpdate_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="82" Height="18" Margin="0,2,8,2"
                        FontSize="10" ToolTip="检查 GitHub 上是否有新版本" />
            </Grid>
        </Border>
    </Grid>
</Window>
