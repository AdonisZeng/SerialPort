<Window x:Class="SerialPort.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="SerialPort  串口调试工具"
        Width="1080" Height="720"
        MinWidth="920" MinHeight="620"
        WindowStartupLocation="CenterScreen"
        FontFamily="Segoe UI" FontSize="12"
        Background="{DynamicResource PanelBackBrush}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 行0 顶栏 -->
            <RowDefinition Height="*" />
            <!-- 行1 接收区 -->
            <RowDefinition Height="Auto" />
            <!-- 行2 分隔条 -->
            <RowDefinition Height="Auto" />
            <!-- 行3 配置 + 发送区 -->
            <RowDefinition Height="Auto" />
            <!-- 行4 状态栏 -->
        </Grid.RowDefinitions>

        <!-- 顶栏：主题切换按钮 -->

        <!-- 接收区：只读文本 + 悬浮清空按钮 -->
        <Grid Grid.Row="1" Background="{DynamicResource PanelBackBrush}">
            <Grid.RowDefinitions>
                <RowDefinition Height="20*"/>
                <RowDefinition Height="103*"/>
            </Grid.RowDefinitions>
            <TextBox x:Name="txtReceive" IsReadOnly="True" TextWrapping="Wrap"
                     VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="10pt"
                     Padding="6,6,78,6"
                     SelectionBrush="#80466EC8" Margin="80,8,10,10" Grid.RowSpan="2" />
            <!-- 左下角悬浮按钮组：筛选 / 搜索 / 清空（居中于界面左边界与接收区左边界之间，锚定左下角随窗口缩放） -->
            <StackPanel Grid.Row="1" HorizontalAlignment="Left" VerticalAlignment="Bottom" Margin="5,0,0,10">
                <Button x:Name="btnFilterReceive" Content="筛选" Click="BtnFilterReceive_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="70" Height="26" Margin="0,0,0,6" ToolTip="按行筛选接收区显示内容" />
                <Button x:Name="btnSearchReceive" Content="搜索" Click="BtnSearchReceive_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="70" Height="26" Margin="0,0,0,6" ToolTip="在接收区中查找内容" />
                <Button x:Name="btnClearReceive" Content="清空" Click="BtnClearReceive_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="70" Height="26" />
            </StackPanel>
        </Grid>

        <!-- 分隔条：可拖动调整接收区与配置区高度 -->
        <GridSplitter Grid.Row="2" Height="2" HorizontalAlignment="Stretch"
                      Background="{DynamicResource SeparatorBrush}"
                      ResizeBehavior="PreviousAndNext" />

        <!-- 配置 + 发送区 -->
        <Grid Grid.Row="3" Background="{DynamicResource HeaderBackBrush}" MinHeight="228">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <!-- 配置区 -->
                <RowDefinition Height="Auto" />
                <!-- 发送框 -->
                <RowDefinition Height="Auto" />
                <!-- 按钮栏 -->
            </Grid.RowDefinitions>

            <!-- 配置区：两行三列下拉 + 复选行 -->
            <Grid Grid.Row="0" Margin="12,8,12,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="170" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 行0：端口号 / 波特率 / 数据位 -->
                <StackPanel Grid.Row="0" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="端口号" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="cboPortName" Width="240" Height="26" IsEditable="False"
                              VerticalContentAlignment="Center"
                              DropDownOpened="cboPortName_DropDown" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="波特率" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="cboBaudRate" Width="102" Height="26" IsEditable="False"
                              VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="0" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="数据位" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="cboDataBits" Width="102" Height="26" IsEditable="False"
                              VerticalContentAlignment="Center" />
                </StackPanel>

                <!-- 行1：停止位 / 校验位 / 流控 -->
                <StackPanel Grid.Row="1" Grid.Column="0" Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="停止位" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="cboStopBits" Width="102" Height="26" IsEditable="False"
                              VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="校验位" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="cboParity" Width="102" Height="26" IsEditable="False"
                              VerticalContentAlignment="Center" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.Column="2" Orientation="Horizontal" Margin="0,0,0,8">
                    <Label Content="流　控" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <ComboBox x:Name="cboHandshake" Width="102" Height="26" IsEditable="False"
                              VerticalContentAlignment="Center" />
                </StackPanel>

                <!-- 行2：打开串口按钮 + 复选项 -->
                <StackPanel Grid.Row="2" Grid.Column="0" Grid.ColumnSpan="4" Orientation="Horizontal">
                    <Button x:Name="btnToggleConnect" Content="打开串口" Click="BtnToggleConnect_Click"
                            Style="{StaticResource AccentButtonStyle}"
                            Background="{StaticResource PortOpenBrush}"
                            Width="88" Height="36" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="chkTimestamp" Content="时间戳显示" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="chkSendHex" Content="16进制发送" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="chkReceiveHex" Content="16进制显示" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="chkSendNewLine" Content="追加换行符" IsChecked="True"
                              Margin="0,0,18,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="chkAutoScroll" Content="自动滚动" IsChecked="True" Margin="0,0,18,0" VerticalAlignment="Center" />
                    <CheckBox x:Name="chkSaveFile" Content="文件保存" VerticalAlignment="Center"
                              Checked="ChkSaveFile_Changed" Unchecked="ChkSaveFile_Changed" />
                </StackPanel>

                <!-- 列3：文件保存区（路径选择 + 文件名修改） -->
                <Grid Grid.Row="0" Grid.Column="3" Grid.RowSpan="2"
                      Margin="18,0,0,0" VerticalAlignment="Center">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <!-- 标签列（两行标签共用，天然左对齐） -->
                        <ColumnDefinition Width="*" />
                        <!-- 输入框列 -->
                        <ColumnDefinition Width="Auto" />
                        <!-- 按钮列 -->
                    </Grid.ColumnDefinitions>
                    <!-- 行0：保存路径 + 浏览按钮 -->
                    <Label Grid.Row="0" Content="文件保存路径" Padding="0" VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox x:Name="txtSavePath" Grid.Row="0" Grid.Column="1" Height="26" IsReadOnly="True"
                             VerticalContentAlignment="Center" />
                    <Button x:Name="btnBrowsePath" Grid.Row="0" Grid.Column="2" Content="…" Width="34" Height="26"
                            Margin="6,0,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnBrowsePath_Click" />
                    <!-- 行1：文件名 + 修改按钮（串口打开时禁止修改） -->
                    <Label Grid.Row="1" Content="        文 件 名" Padding="0" VerticalAlignment="Center" Margin="0,8,6,0" />
                    <TextBox x:Name="txtSaveFileName" Grid.Row="1" Grid.Column="1" Height="26" IsReadOnly="True"
                             VerticalContentAlignment="Center" Margin="0,8,0,0" />
                    <Button x:Name="btnModifyFileName" Grid.Row="1" Grid.Column="2" Content="修改" Width="40" Height="26"
                            Margin="6,8,0,0" Style="{StaticResource SecondaryButtonStyle}" Click="BtnModifyFileName_Click" />
                </Grid>

            </Grid>

            <!-- 发送框 -->
            <TextBox x:Name="txtSend" Grid.Row="1" Height="84" Margin="12,0,12,8"
                     TextWrapping="Wrap" VerticalScrollBarVisibility="Auto"
                     FontFamily="Consolas" FontSize="10pt" />

            <!-- 按钮栏 -->
            <StackPanel Grid.Row="2" Orientation="Horizontal" Height="32"
                        HorizontalAlignment="Left" Margin="12,0,0,8">
                <Button x:Name="btnSend" Content="发送" Click="BtnSend_Click"
                        Style="{StaticResource AccentButtonStyle}"
                        Background="{StaticResource SendBtnBrush}"
                        Width="90" Height="28" Margin="0,0,8,0" />
                <Button x:Name="btnClearSend" Content="清空" Click="BtnClearSend_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="70" Height="26" />
            </StackPanel>
            <Button x:Name="btnThemeToggle" Content="深色模式" Click="BtnThemeToggle_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="100" Height="28"
                    HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,0,12,0" Grid.Row="2" />
        </Grid>

        <!-- 状态栏：左侧动态状态信息，右侧检查更新入口 -->
        <Border Grid.Row="4" Height="22" Background="{DynamicResource TopBarBackBrush}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <TextBlock x:Name="txtStatus" Text="  就绪" Margin="12,0,0,0"
                           VerticalAlignment="Center"
                           Foreground="{DynamicResource StatusTextBrush}" />
                <Button x:Name="btnCheckUpdate" Grid.Column="1" Content="检查更新" Click="BtnCheckUpdate_Click"
                        Style="{StaticResource SecondaryButtonStyle}"
                        Width="82" Height="18" Margin="0,2,8,2"
                        FontSize="10" ToolTip="检查 GitHub 上是否有新版本" />
            </Grid>
        </Border>
    </Grid>
</Window>
