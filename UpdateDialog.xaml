<Window x:Class="SerialPort.UpdateDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="软件更新"
        Width="480" Height="430"
        ResizeMode="NoResize" ShowInTaskbar="False"
        WindowStartupLocation="CenterOwner"
        FontFamily="Segoe UI" FontSize="12"
        Background="{DynamicResource PanelBackBrush}">
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <!-- 标题 -->
            <RowDefinition Height="Auto" />
            <!-- 版本信息 -->
            <RowDefinition Height="Auto" />
            <!-- 更新说明标题 -->
            <RowDefinition Height="*" />
            <!-- 更新说明正文 -->
            <RowDefinition Height="Auto" />
            <!-- 下载进度 -->
            <RowDefinition Height="Auto" />
            <!-- 错误信息 -->
            <RowDefinition Height="Auto" />
            <!-- 按钮行 -->
        </Grid.RowDefinitions>

        <TextBlock x:Name="txtTitle" Grid.Row="0" FontSize="17" FontWeight="SemiBold"
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <TextBlock x:Name="txtVersionInfo" Grid.Row="1" Margin="0,6,0,0"
                   Foreground="{DynamicResource StatusTextBrush}" />

        <TextBlock Grid.Row="2" Margin="0,14,0,4" Text="更新说明："
                   Foreground="{DynamicResource TextPrimaryBrush}" />

        <RichTextBox x:Name="txtReleaseNotes" Grid.Row="3" IsReadOnly="True"
                     VerticalScrollBarVisibility="Auto" FontFamily="Microsoft YaHei UI" FontSize="11"
                     Padding="6" Background="{DynamicResource InputBackBrush}"
                     Foreground="{DynamicResource InputForeBrush}"
                     BorderBrush="{DynamicResource SecondaryBtnBorderBrush}" />

        <!-- 下载进度（开始更新后可见） -->
        <StackPanel x:Name="panelProgress" Grid.Row="4" Margin="0,12,0,0" Visibility="Collapsed">
            <ProgressBar x:Name="progressBar" Height="12" Minimum="0" Maximum="100" />
            <TextBlock x:Name="txtProgress" Margin="0,4,0,0"
                       Foreground="{DynamicResource StatusTextBrush}" />
        </StackPanel>

        <!-- 错误信息（出错后可见） -->
        <TextBlock x:Name="txtError" Grid.Row="5" Margin="0,10,0,0" TextWrapping="Wrap"
                   Foreground="#C84646" Visibility="Collapsed" />

        <!-- 按钮行 -->
        <StackPanel Grid.Row="6" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="btnUpdate" Content="立即更新" Click="BtnUpdate_Click"
                    Style="{StaticResource AccentButtonStyle}"
                    Background="{StaticResource SendBtnBrush}"
                    Width="96" Height="30" Margin="0,0,10,0" />
            <Button x:Name="btnLater" Content="稍后再说" Click="BtnLater_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="96" Height="30" />
        </StackPanel>
    </Grid>
</Window>
