<Window x:Class="SerialPort.SearchFilterWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="搜索" Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        FontFamily="Segoe UI" FontSize="12"
        Background="{DynamicResource PanelBackBrush}">
    <StackPanel Margin="14">
        <!-- 查找 / 筛选内容输入 -->
        <StackPanel Orientation="Horizontal">
            <Label x:Name="lblInput" Content="查找内容" Padding="0" VerticalAlignment="Center" Margin="0,0,8,0" />
            <TextBox x:Name="txtTerm" Width="240" Height="26" VerticalContentAlignment="Center"
                     KeyDown="TxtTerm_KeyDown" />
        </StackPanel>
        <!-- 匹配选项 -->
        <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
            <CheckBox x:Name="chkMatchCase" Content="匹配大小写" Margin="0,0,18,0" VerticalAlignment="Center" />
            <CheckBox x:Name="chkWholeWord" Content="全词匹配" VerticalAlignment="Center" />
        </StackPanel>
        <!-- 操作按钮：搜索模式 = 查找下一个 / 上一个；筛选模式 = 筛选 / 清除筛选（按模式折叠另一组） -->
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button x:Name="btnFindNext" Content="查找下一个" Click="BtnFindNext_Click"
                    Style="{StaticResource AccentButtonStyle}" Background="{StaticResource SendBtnBrush}"
                    Width="96" Height="28" Margin="0,0,8,0" />
            <Button x:Name="btnFindPrev" Content="查找上一个" Click="BtnFindPrev_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="96" Height="28" Margin="0,0,8,0" />
            <Button x:Name="btnApplyFilter" Content="筛选" Click="BtnApplyFilter_Click"
                    Style="{StaticResource AccentButtonStyle}" Background="{StaticResource SendBtnBrush}"
                    Width="96" Height="28" Margin="0,0,8,0" />
            <Button x:Name="btnClearFilter" Content="清除筛选" Click="BtnClearFilter_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="96" Height="28" Margin="0,0,8,0" />
            <Button x:Name="btnClose" Content="关闭" Click="BtnClose_Click"
                    Style="{StaticResource SecondaryButtonStyle}"
                    Width="70" Height="28" />
        </StackPanel>
        <!-- 状态提示 -->
        <TextBlock x:Name="txtStatus" Margin="0,10,0,0"
                   Foreground="{DynamicResource StatusTextBrush}" />
    </StackPanel>
</Window>
