<Application x:Class="SerialPort.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 第 0 项必须为默认主题：ThemeManager.Apply 按索引 0 替换 -->
                <ResourceDictionary Source="Themes/LightTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 常量强调色：两主题一致，不随主题变化 -->
            <SolidColorBrush x:Key="PortOpenBrush" Color="#009688" />
            <SolidColorBrush x:Key="PortCloseBrush" Color="#C84646" />
            <SolidColorBrush x:Key="SendBtnBrush" Color="#466EC8" />

            <!-- 全局样式：颜色一律 DynamicResource，主题切换即时生效 -->
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{DynamicResource InputBackBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource InputForeBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorderBrush}" />
                <Setter Property="Padding" Value="4" />
            </Style>
            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="Background" Value="{DynamicResource InputBackBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource InputForeBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorderBrush}" />
            </Style>
            <Style TargetType="{x:Type CheckBox}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Style>
            <Style TargetType="{x:Type Label}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Style>

            <!-- 强调色按钮（打开串口 / 发送）：白字加粗，背景由实例显式指定 -->
            <Style x:Key="AccentButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 次要按钮（清空 / 主题切换）：随主题变化 -->
            <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Background" Value="{DynamicResource SecondaryBtnBackBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryBtnForeBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}">
                                <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                  VerticalAlignment="{TemplateBinding VerticalContentAlignment}" />
                            </Border>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
