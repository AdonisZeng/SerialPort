<Application x:Class="SerialPort.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <!-- 默认主题（浅色）：ThemeManager.Apply 按 Source 定位替换，找不到时才插入到最前 -->
                <ResourceDictionary Source="Themes/LightTheme.xaml" />
            </ResourceDictionary.MergedDictionaries>

            <!-- 下拉框共用模板（应用级资源：主窗口与帧解析等子窗口共用）：
                 选中项文本过长时以省略号截断（保留下拉箭头），下拉选项仍完整显示。
                 文本列与箭头列分离，默认模板中选中项文字会覆盖箭头，导致长描述时箭头不可见。 -->
            <ControlTemplate x:Key="ComboBoxTemplate" TargetType="{x:Type ComboBox}">
                <Grid x:Name="templateRoot" SnapsToDevicePixels="True">
                    <!-- 箭头列固定 18px（与按钮模板内箭头区宽度一致）；若不固定列宽，文本列会
                         延伸到箭头下方，导致文字与三角形重叠 -->
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="18" />
                    </Grid.ColumnDefinitions>
                    <ToggleButton x:Name="ToggleButton" Grid.ColumnSpan="2" Focusable="False"
                                  IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                        <ToggleButton.Template>
                            <ControlTemplate TargetType="{x:Type ToggleButton}">
                                <Border x:Name="toggleRoot"
                                        Background="{DynamicResource InputBackBrush}"
                                        BorderBrush="{DynamicResource SecondaryBtnBorderBrush}"
                                        BorderThickness="1" SnapsToDevicePixels="True">
                                    <Border x:Name="splitBorder" Width="18" HorizontalAlignment="Right"
                                            BorderBrush="{DynamicResource SecondaryBtnBorderBrush}"
                                            BorderThickness="1,0,0,0">
                                        <Path x:Name="arrow" Data="M 0 0 L 4 4 L 8 0 Z"
                                              Fill="{DynamicResource InputForeBrush}"
                                              HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,1,0,0" />
                                    </Border>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="toggleRoot" Property="Background"
                                                Value="{DynamicResource ComboHoverBackBrush}" />
                                        <Setter TargetName="toggleRoot" Property="BorderBrush"
                                                Value="{DynamicResource ComboHoverBackBrush}" />
                                        <Setter TargetName="arrow" Property="Fill"
                                                Value="{DynamicResource InputForeBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsChecked" Value="True">
                                        <Setter TargetName="toggleRoot" Property="Background"
                                                Value="{DynamicResource ComboHoverBackBrush}" />
                                        <Setter TargetName="toggleRoot" Property="BorderBrush"
                                                Value="{DynamicResource ComboHoverBackBrush}" />
                                        <Setter TargetName="arrow" Property="Fill"
                                                Value="{DynamicResource InputForeBrush}" />
                                    </Trigger>
                                    <Trigger Property="IsEnabled" Value="False">
                                        <Setter TargetName="toggleRoot" Property="Background"
                                                Value="{DynamicResource InputBackBrush}" />
                                        <Setter TargetName="toggleRoot" Property="BorderBrush"
                                                Value="{DynamicResource SeparatorBrush}" />
                                        <Setter TargetName="arrow" Property="Fill"
                                                Value="{DynamicResource SeparatorBrush}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </ToggleButton.Template>
                    </ToggleButton>
                    <!-- 选中项文本：限定在文本列内，超出部分以省略号截断。
                         用普通 Binding（而非 TemplateBinding）绑定 SelectionBoxItem，
                         TemplateBinding 不做对象→字符串转换，会导致选中项不显示。 -->
                    <TextBlock x:Name="SelectionTextBlock" Grid.Column="0" IsHitTestVisible="False"
                               Text="{Binding SelectionBoxItem, RelativeSource={RelativeSource TemplatedParent}}"
                               TextTrimming="CharacterEllipsis"
                               VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                               HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                               Margin="5,0,0,0"
                               Foreground="{TemplateBinding Foreground}" />
                    <TextBox x:Name="PART_EditableTextBox" Grid.Column="0"
                             Visibility="Collapsed"
                             Text="{TemplateBinding Text}"
                             VerticalContentAlignment="{TemplateBinding VerticalContentAlignment}"
                             HorizontalContentAlignment="{TemplateBinding HorizontalContentAlignment}"
                             Margin="4,0,2,0"
                             Background="Transparent"
                             BorderThickness="0"
                             CaretBrush="{TemplateBinding Foreground}"
                             Foreground="{TemplateBinding Foreground}" />
                    <Popup x:Name="PART_Popup" Grid.ColumnSpan="2" AllowsTransparency="True" Margin="1"
                           IsOpen="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}"
                           PopupAnimation="{DynamicResource {x:Static SystemParameters.ComboBoxPopupAnimationKey}}"
                           Placement="Bottom">
                        <!-- 下拉面板：MinWidth 与下拉框同宽，内容更宽时可扩展（完整显示端口描述） -->
                        <Border x:Name="DropDownBorder"
                                MinWidth="{Binding ActualWidth, ElementName=ToggleButton}"
                                MaxHeight="{TemplateBinding MaxDropDownHeight}"
                                Background="{DynamicResource InputBackBrush}"
                                BorderBrush="{DynamicResource SecondaryBtnBorderBrush}"
                                BorderThickness="1">
                            <ScrollViewer x:Name="DropDownScrollViewer">
                                <Grid RenderOptions.ClearTypeHint="Enabled">
                                    <ItemsPresenter x:Name="ItemsPresenter"
                                                    KeyboardNavigation.DirectionalNavigation="Contained" />
                                </Grid>
                            </ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEditable" Value="True">
                        <Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible" />
                        <Setter TargetName="SelectionTextBlock" Property="Visibility" Value="Collapsed" />
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate>

            <!-- 常量强调色：两主题一致，不随主题变化 -->
            <SolidColorBrush x:Key="PortOpenBrush" Color="#009688" />
            <SolidColorBrush x:Key="PortCloseBrush" Color="#C84646" />
            <SolidColorBrush x:Key="SendBtnBrush" Color="#466EC8" />

            <!-- 全局样式：颜色一律 DynamicResource，主题切换即时生效 -->
            <Style TargetType="{x:Type TextBox}">
                <Setter Property="Background" Value="{DynamicResource InputBackBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource InputForeBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorderBrush}" />
                <Setter Property="Padding" Value="4" />
            </Style>
            <Style TargetType="{x:Type ComboBox}">
                <Setter Property="Background" Value="{DynamicResource InputBackBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource InputForeBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorderBrush}" />
            </Style>
            <Style TargetType="{x:Type CheckBox}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Style>
            <Style TargetType="{x:Type Label}">
                <Setter Property="Foreground" Value="{DynamicResource TextPrimaryBrush}" />
            </Style>

            <!-- 按钮共用模板：现代微 3D 四态反馈（悬浮 / 按下 / 键盘焦点 / 禁用）。
                 立体感与状态反馈全部由黑白半透明叠加层实现，自动适配任意底色与明暗主题：
                 - 高光层 / 阴影层常驻，模拟轻微凸起；
                 - 悬浮提亮层（白 0.20 渐变）+ 悬浮压暗层（黑 0.08 实色）叠加于悬浮 / 焦点，
                   近白浅色底靠压暗层变暗、深色底与强调色靠提亮层提亮（亮度自适应）；
                 - 按下时高光消失 + 均匀加深 + 内容下沉 1px，形成"按下去"的凹陷感；
                 - 禁用时整体灰化（Opacity 0.4）且不再响应悬浮。 -->
            <!-- 强调色按钮（打开串口 / 发送 / 立即更新 / 查找 / 筛选）：白字加粗，背景由实例显式指定 -->
            <Style x:Key="AccentButtonStyle" TargetType="{x:Type Button}">
                <Setter Property="Foreground" Value="White" />
                <Setter Property="FontWeight" Value="SemiBold" />
                <Setter Property="Template">
                    <Setter.Value>
                        <ControlTemplate TargetType="{x:Type Button}">
                            <Border x:Name="Bd" Background="{TemplateBinding Background}"
                                    BorderBrush="{TemplateBinding BorderBrush}"
                                    BorderThickness="{TemplateBinding BorderThickness}"
                                    CornerRadius="4" Padding="{TemplateBinding Padding}"
                                    SnapsToDevicePixels="True">
                                <Grid>
                                    <!-- 高光层：顶部白色渐变，模拟凸起 -->
                                    <Border x:Name="HighlightLayer" IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#29FFFFFF" Offset="0" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- 阴影层：底部黑色渐变，增强立体感 -->
                                    <Border IsHitTestVisible="False">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,1" EndPoint="0,0">
                                                <GradientStop Color="#24000000" Offset="0" />
                                                <GradientStop Color="#00000000" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- 悬浮提亮层：白 0.20 渐变，悬浮 / 焦点时叠加 -->
                                    <Border x:Name="HoverLightLayer" IsHitTestVisible="False" Opacity="0">
                                        <Border.Background>
                                            <LinearGradientBrush StartPoint="0,0" EndPoint="0,1">
                                                <GradientStop Color="#33FFFFFF" Offset="0" />
                                                <GradientStop Color="#00FFFFFF" Offset="1" />
                                            </LinearGradientBrush>
                                        </Border.Background>
                                    </Border>
                                    <!-- 悬浮压暗层：黑 0.08 实色，悬浮 / 焦点时叠加 -->
                                    <Border x:Name="HoverShadeLayer" IsHitTestVisible="False"
                                            Opacity="0" Background="#14000000" />
                                    <!-- 按下加深层：黑 0.16 实色，按下时均匀加深 -->
                                    <Border x:Name="PressLayer" IsHitTestVisible="False"
                                            Opacity="0" Background="#29000000" />
                                    <!-- 内容层：按下时经内联样式 DataTrigger 整体下沉 1px（RenderTransform 平移，
                                         不触发重新布局；内联样式随模板实例化复制，每按钮独立，无共享状态） -->
                                    <ContentPresenter x:Name="Content"
                                                      HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                                      VerticalAlignment="{TemplateBinding VerticalContentAlignment}">
                                        <ContentPresenter.Style>
                                            <Style TargetType="{x:Type ContentPresenter}">
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsPressed, RelativeSource={RelativeSource TemplatedParent}}" Value="True">
                                                        <Setter Property="RenderTransform">
                                                            <Setter.Value>
                                                                <TranslateTransform Y="1" />
                                                            </Setter.Value>
                                                        </Setter>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </ContentPresenter.Style>
                                    </ContentPresenter>
                                </Grid>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True">
                                    <Setter TargetName="HoverLightLayer" Property="Opacity" Value="1" />
                                    <Setter TargetName="HoverShadeLayer" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsKeyboardFocused" Value="True">
                                    <Setter TargetName="HoverLightLayer" Property="Opacity" Value="1" />
                                    <Setter TargetName="HoverShadeLayer" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsPressed" Value="True">
                                    <Setter TargetName="HighlightLayer" Property="Opacity" Value="0" />
                                    <Setter TargetName="HoverLightLayer" Property="Opacity" Value="0" />
                                    <Setter TargetName="HoverShadeLayer" Property="Opacity" Value="0" />
                                    <Setter TargetName="PressLayer" Property="Opacity" Value="1" />
                                </Trigger>
                                <Trigger Property="IsEnabled" Value="False">
                                    <Setter Property="Opacity" Value="0.4" />
                                    <Setter TargetName="HoverLightLayer" Property="Opacity" Value="0" />
                                    <Setter TargetName="HoverShadeLayer" Property="Opacity" Value="0" />
                                    <Setter TargetName="PressLayer" Property="Opacity" Value="0" />
                                </Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate>
                    </Setter.Value>
                </Setter>
            </Style>

            <!-- 次要按钮（清空 / 筛选 / 主题切换等）：继承强调色按钮模板，仅覆盖配色（随主题变化）与字重 -->
            <Style x:Key="SecondaryButtonStyle" TargetType="{x:Type Button}"
                   BasedOn="{StaticResource AccentButtonStyle}">
                <Setter Property="Background" Value="{DynamicResource SecondaryBtnBackBrush}" />
                <Setter Property="Foreground" Value="{DynamicResource SecondaryBtnForeBrush}" />
                <Setter Property="BorderBrush" Value="{DynamicResource SecondaryBtnBorderBrush}" />
                <Setter Property="BorderThickness" Value="1" />
                <Setter Property="FontWeight" Value="Normal" />
            </Style>
        </ResourceDictionary>
    </Application.Resources>
</Application>
