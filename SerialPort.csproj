  <!-- 构建前根据 <Version> 生成程序集版本号（AssemblyVersion/AssemblyFileVersion/AssemblyInformationalVersion）。
       版本号只改上面 <Version> 一处；AssemblyInfo.cs 中不再写版本。 -->
  <Target Name="BeforeCompile">
    <ItemGroup>
      <AssemblyAttributes Include="AssemblyVersion">
        <_Parameter1>$(Version).0</_Parameter1>
      </AssemblyAttributes>
      <AssemblyAttributes Include="AssemblyFileVersion">
        <_Parameter1>$(Version).0</_Parameter1>
      </AssemblyAttributes>
      <AssemblyAttributes Include="AssemblyInformationalVersion">
        <_Parameter1>$(Version)</_Parameter1>
      </AssemblyAttributes>
    </ItemGroup>
    <WriteCodeFragment Language="C#"
                       OutputFile="$(IntermediateOutputPath)VersionInfo.cs"
                       AssemblyAttributes="@(AssemblyAttributes)" />
    <ItemGroup>
      <Compile Include="$(IntermediateOutputPath)VersionInfo.cs" />
    </ItemGroup>
  </Target>
