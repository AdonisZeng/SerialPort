<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <!-- 深色主题调色板（与源 WinForms 版 ThemeManager.DarkPalette 色值一致） -->
    <SolidColorBrush x:Key="TopBarBackBrush" Color="#1E212C" />
    <SolidColorBrush x:Key="PanelBackBrush" Color="#1E222E" />
    <SolidColorBrush x:Key="HeaderBackBrush" Color="#262A36" />
    <SolidColorBrush x:Key="InputBackBrush" Color="#1E222E" />
    <SolidColorBrush x:Key="InputForeBrush" Color="#DCE6F0" />
    <SolidColorBrush x:Key="TextPrimaryBrush" Color="#DCE6F0" />
    <SolidColorBrush x:Key="StatusTextBrush" Color="#FFFFFF" />
    <SolidColorBrush x:Key="SeparatorBrush" Color="#2D303C" />
    <SolidColorBrush x:Key="SecondaryBtnBackBrush" Color="#3C4150" />
    <SolidColorBrush x:Key="SecondaryBtnForeBrush" Color="#DCE6F0" />
    <SolidColorBrush x:Key="SecondaryBtnBorderBrush" Color="#5A5F6E" />
</ResourceDictionary>
